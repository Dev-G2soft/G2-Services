//------------------------------------------------------------------------------
//   Procedure para liberar a memória não usada, limpar o lixo da memória, o DELPHI tem essa característica.
//   informação de http://www.agnaldocarmo.com.br/home/comando-milagroso-para-reducao-de-memoria-delphi/
//   Colocar em USES "psapi"
//------------------------------------------------------------------------------
procedure SA_Limpar_Memoria;
var
   MainHandle : THandle;
begin
   try
      MainHandle := OpenProcess(PROCESS_ALL_ACCESS, false, GetCurrentProcessID) ;
      SetProcessWorkingSetSize(MainHandle, $FFFFFFFF, $FFFFFFFF) ;
      CloseHandle(MainHandle) ;
   except
   end;
   Application.ProcessMessages;
 end;
//------------------------------------------------------------------------------
//   Calcular tempo entre dois instantes
//------------------------------------------------------------------------------
function calcularDiferencaHoras(DataHoraI,DataHoraF:TDateTime):string;
var
   Dias     : Integer;
   Total    : Real;
   Horas    : Real;
   H        : Word;
   M        : Word;
   S        : Word;
   SS       : Word;
begin
   if DataHoraI > DataHoraF then
      Total := DataHoraI - DataHoraF
   else
      Total:= DataHoraF - DataHoraI;
   Dias := Trunc(total);
   Horas:=total - Trunc(total);
   Decodetime(Horas,H,M,S,SS);
   H := H +24 * TRunc(dias);
   if Dias>0 then
      Result := inttostr(dias)+' Dias ' + FormatFloat('#00',H)+':'+FormatFloat('00',m)+':'+FormatFloat('00',s)
   else
      Result := FormatFloat('#00',H)+':'+FormatFloat('00',m)+':'+FormatFloat('00',s);
end;
